
/* ANVI'S PORTFOLIO — BURGUNDY & CREAM */

:root {
  --wine: #641F35;
  --cream: #F4EBDD;
  --ivory: #FFFCF6;
  --ink: #302722;
  --muted: #786E68;
  --line: #DCCFC0;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--cream);
  color: var(--ink);
  font-family: "DM Sans", sans-serif;
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

.section-shell {
  width: min(1160px, 88%);
  margin: auto;
}

.site-header {
  min-height: 82px;
  padding: 18px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
}

.logo {
  font-family: "Cormorant Garamond", serif;
  font-size: 38px;
  font-weight: 700;
  color: var(--wine);
}

.logo span {
  color: var(--ink);
}

.site-header nav {
  display: flex;
  gap: 28px;
  font-size: 13px;
}

.site-header nav a,
.text-link,
.contact-secondary {
  transition: opacity 0.2s ease;
}

.site-header nav a:hover,
.text-link:hover,
.contact-secondary:hover {
  opacity: 0.6;
}

.nav-cta {
  color: var(--wine);
  font-size: 13px;
  font-weight: 700;
}

.hero {
  min-height: 650px;
  padding: 85px 0;
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 65px;
  align-items: center;
}

.eyebrow,
.project-type,
.hero-note {
  color: var(--wine);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.hero h1,
.section-heading h2,
.contact-section h2 {
  font-family: "Cormorant Garamond", serif;
  font-weight: 600;
  line-height: 1.08;
}

.hero h1 {
  margin: 25px 0;
  font-size: clamp(48px, 6vw, 76px);
}

.hero h1 em,
.section-heading h2 em,
.contact-section h2 em {
  color: var(--wine);
  font-weight: 500;
}

.hero-description {
  max-width: 510px;
  color: var(--muted);
  font-size: 15px;
}

.hero-actions,
.contact-links {
  display: flex;
  align-items: center;
  gap: 25px;
  margin-top: 30px;
}

.button {
  display: inline-block;
  padding: 13px 21px;
  font-size: 12px;
  font-weight: 700;
}

.button-dark {
  background: var(--wine);
  color: var(--ivory);
}

.button-light {
  background: var(--cream);
  color: var(--wine);
}

.button span {
  margin-left: 12px;
}

.text-link,
.contact-secondary {
  font-size: 12px;
  font-weight: 700;
}

.hero-note {
  margin-top: 55px;
  font-size: 9px;
}

.photo-frame {
  padding: 13px;
  border: 1px solid var(--wine);
  transform: rotate(2deg);
}

.photo-frame img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.photo-caption {
  display: flex;
  justify-content: space-between;
  margin-top: 18px;
  font-family: "Cormorant Garamond", serif;
  font-size: 16px;
}

.photo-caption span,
.side-note {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 1px;
}

.side-note {
  display: block;
  margin-top: 25px;
  text-align: right;
}

.about-section,
.work-section,
.education-section,
.skills-section {
  padding: 100px 0;
  border-top: 1px solid var(--line);
}

.section-heading h2 {
  max-width: 750px;
  margin-top: 18px;
  font-size: clamp(38px, 5vw, 58px);
}

.about-content {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 90px;
  margin-top: 55px;
}

.about-lead {
  font-family: "Cormorant Garamond", serif;
  font-size: 32px;
  line-height: 1.3;
  color: var(--wine);
}

.about-details p {
  margin-bottom: 18px;
  color: var(--muted);
  font-size: 14px;
}

.about-stamp {
  width: 175px;
  height: 175px;
  margin: 65px auto 0;
  border: 1px solid var(--wine);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--wine);
  transform: rotate(-8deg);
}

.about-stamp span {
  font-size: 9px;
  letter-spacing: 2px;
}

.about-stamp strong {
  font-family: "Cormorant Garamond", serif;
  font-size: 27px;
}

.section-intro {
  margin-top: 15px;
  color: var(--muted);
  font-size: 14px;
}

.work-category {
  margin-top: 75px;
}

.category-heading {
  display: flex;
  align-items: center;
  gap: 22px;
  margin-bottom: 30px;
}

.category-number {
  color: var(--wine);
  font-family: "Cormorant Garamond", serif;
  font-size: 40px;
}

.category-heading h3,
.skill-group h3 {
  font-family: "Cormorant Garamond", serif;
  font-size: 28px;
  font-weight: 600;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.project-card {
  padding: 30px;
  background: var(--ivory);
  border: 1px solid var(--line);
}

.featured-project {
  background: #EADBD2;
}

.project-card h4 {
  margin: 12px 0;
  font-family: "Cormorant Garamond", serif;
  font-size: 29px;
}

.project-card > p:last-of-type {
  color: var(--muted);
  font-size: 13px;
}

.project-result {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 25px;
  color: var(--wine);
}

.project-result strong {
  font-family: "Cormorant Garamond", serif;
  font-size: 34px;
  white-space: nowrap;
}

.project-result span {
  max-width: 190px;
  font-size: 11px;
  line-height: 1.5;
}

.entrepreneurship-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
}

.education-list {
  margin-top: 45px;
}

.education-item {
  display: flex;
  gap: 30px;
  padding: 28px 0;
  border-bottom: 1px solid var(--line);
}

.education-index {
  color: var(--wine);
  font-family: "Cormorant Garamond", serif;
  font-size: 30px;
}

.education-item h3 {
  font-family: "Cormorant Garamond", serif;
  font-size: 25px;
}

.education-item p,
.education-status {
  color: var(--muted);
  font-size: 13px;
}

.education-status {
  color: var(--wine);
}

.skills-layout {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 35px;
  margin-top: 45px;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 18px;
}

.skill-tags span {
  padding: 8px 12px;
  border: 1px solid var(--line);
  font-size: 11px;
}

.contact-section {
  padding: 90px 7%;
  background: var(--wine);
  color: var(--ivory);
  text-align: center;
}

.contact-section .eyebrow,
.contact-section h2 em {
  color: var(--cream);
}

.contact-section h2 {
  max-width: 750px;
  margin: 20px auto;
  font-size: clamp(42px, 6vw, 65px);
}

.contact-section > p:not(.eyebrow) {
  max-width: 520px;
  margin: auto;
  color: #E6D7D5;
  font-size: 14px;
}

.contact-links {
  justify-content: center;
}

.resume-section {
  padding: 75px 0;
}

.resume-download {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 35px;
  border-bottom: 1px solid var(--line);
}

.resume-download h2 {
  font-family: "Cormorant Garamond", serif;
  font-size: 30px;
}

#resume {
  max-width: 800px;
  margin: 50px auto;
  padding: 45px;
  background: white;
  color: #222;
  font-size: 11px;
  line-height: 1.45;
}

#resume h1 {
  font-size: 28px;
  letter-spacing: 3px;
}

#resume h2 {
  margin: 20px 0 8px;
  padding-bottom: 4px;
  border-bottom: 1px solid #999;
  font-size: 13px;
}

#resume h3 {
  margin-top: 12px;
  font-size: 11px;
}

#resume p,
#resume li {
  margin-bottom: 5px;
}

#resume ul {
  padding-left: 18px;
}

.resume-contact {
  margin: 8px 0 15px;
}

.resume-profile {
  margin-bottom: 18px;
}

.site-footer {
  padding: 25px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--line);
  font-size: 11px;
}

@media (max-width: 700px) {
  .site-header {
    flex-wrap: wrap;
    gap: 12px;
  }

  .site-header nav {
    order: 3;
    width: 100%;
    justify-content: space-between;
    gap: 8px;
    font-size: 11px;
  }

  .hero {
    grid-template-columns: 1fr;
    padding: 60px 0;
    gap: 45px;
  }

  .hero-visual {
    max-width: 380px;
    margin: auto;
  }

  .about-content,
  .project-grid,
  .skills-layout {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .about-section,
  .work-section,
  .education-section,
  .skills-section {
    padding: 65px 0;
  }

  .entrepreneurship-card,
  .resume-download {
    flex-direction: column;
    align-items: flex-start;
  }

  .contact-section {
    padding: 65px 7%;
  }

  .site-footer {
    flex-wrap: wrap;
    gap: 12px;
  }

  #resume {
    padding: 20px;
  }
}

@media print {
  @page {
    size: A4;
    margin: 12mm;
  }

  body * {
    visibility: hidden;
  }

  #resume,
  #resume * {
    visibility: visible;
  }

  #resume {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    background: white;
    color: black;
    font-size: 9pt;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
